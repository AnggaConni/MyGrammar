    {
      "id": "CLEAN-004",
      "type": "clean",
      "input": "I agree with you.",
      "expected": []
    },
    {
      "id": "CLEAN-005",
      "type": "clean",
      "input": "We discussed the problem.",
      "expected": []
    },
    {
      "id": "CLEAN-006",
      "type": "clean",
      "input": "She is very beautiful.",
      "expected": []
    },
    {
      "id": "CLEAN-007",
      "type": "clean",
      "input": "I have already sent it.",
      "expected": []
    },
    {
      "id": "CLEAN-008",
      "type": "clean",
      "input": "This is 20 years old.",
      "expected": []
    },
    {
      "id": "MULTI-001",
      "type": "detect",
      "input": "She go to work every day. He dont like coffee.",
      "expected": [
        {
          "wrong": "She go",
          "correct": "She goes",
          "category": "Grammar",
          "title": "Subject–verb agreement"
        },
        {
          "wrong": "dont",
          "correct": "don't",
          "category": "Spelling",
          "title": "Spelling"
        }
      ]
    }
  ]
}
